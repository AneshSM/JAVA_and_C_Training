package com.lastproject;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.SQLException;
import java.sql.Statement;
import java.util.Scanner;

public class DeleteValue {
	public static void main(String[] args) throws SQLException, ClassNotFoundException {
		Class.forName("com.mysql.cj.jdbc.Driver");
		Connection con1= DriverManager.getConnection("jdbc:mysql://localhost:3306/lastdatabase","root","root");
		
		Scanner sc=new Scanner(System.in);
		
		System.out.println("Enter a student id to update:");
		int id=sc.nextInt();
		PreparedStatement ps = con1.prepareStatement("update student set phone=?,email=? where sid="+id);
		for(int i=1;i<=1;i++) {
			System.out.println("Enter the phone number to update:");
			long ph=sc.nextLong();
			System.out.println("Enter the email to update:");
			String email=sc.next();
			
			ps.setLong(1, ph);
			ps.setString(2,email);
			
			ps.executeUpdate();
		}
}
}
